generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum InterestType {
  SIMPLE
  COMPOUND
}

enum LoanFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum LoanStatus {
  PENDING
  APPROVED
  ACTIVE
  PAID
  DEFAULTED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  TRANSFER
  MOBILE
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  email           String      @unique
  passwordHash    String
  role            UserRole    @default(OPERATOR)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  approvedLoans   Loan[]      @relation("LoanApprover")
  receivedPayments Payment[]  @relation("PaymentReceiver")
  auditLogs       AuditLog[]
}

model Client {
  id             String       @id @default(uuid()) @db.Uuid
  fullName       String
  documentType   String
  documentNumber String       @unique
  phone          String?
  address        String?
  occupation     String?
  monthlyIncome  Decimal?     @db.Decimal(12, 2)
  status         ClientStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  loans          Loan[]

  @@index([status])
}

model Loan {
  id              String        @id @default(uuid()) @db.Uuid
  clientId        String        @db.Uuid
  principalAmount Decimal       @db.Decimal(12, 2)
  interestRate    Decimal       @db.Decimal(7, 4)
  interestType    InterestType
  termMonths      Int
  frequency       LoanFrequency
  startDate       DateTime      @db.Date
  status          LoanStatus    @default(PENDING)
  approvedById    String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  approvedBy      User?         @relation("LoanApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  installments    Installment[]
  payments        Payment[]

  @@index([clientId])
  @@index([approvedById])
  @@index([status])
}

model Installment {
  id           String            @id @default(uuid()) @db.Uuid
  loanId       String            @db.Uuid
  number       Int
  dueDate      DateTime          @db.Date
  principalPart Decimal          @db.Decimal(12, 2)
  interestPart Decimal           @db.Decimal(12, 2)
  totalAmount  Decimal           @db.Decimal(12, 2)
  paidAmount   Decimal           @default(0) @db.Decimal(12, 2)
  status       InstallmentStatus @default(PENDING)
  loan         Loan              @relation(fields: [loanId], references: [id], onDelete: Restrict)
  payments     Payment[]

  @@unique([loanId, number])
  @@index([loanId])
  @@index([dueDate])
  @@index([status])
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  loanId        String        @db.Uuid
  installmentId String?       @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  receivedById  String        @db.Uuid
  reversedAt    DateTime?
  notes         String?
  loan          Loan          @relation(fields: [loanId], references: [id], onDelete: Restrict)
  installment   Installment?  @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  receivedBy    User          @relation("PaymentReceiver", fields: [receivedById], references: [id], onDelete: Restrict)

  @@index([loanId])
  @@index([installmentId])
  @@index([receivedById])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}
