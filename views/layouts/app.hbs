<!doctype html>
<html lang="pt-AO">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0B1F3A">
    <title>{{appName}} | Área de cliente</title>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/vendor/bootstrap-icons/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/vendor/fonts/latin-400.css">
    <link rel="stylesheet" href="/vendor/fonts/latin-500.css">
    <link rel="stylesheet" href="/vendor/fonts/latin-600.css">
    <link rel="stylesheet" href="/vendor/fonts/latin-700.css">
    <link rel="stylesheet" href="/vendor/fonts/latin-800.css">
    <link rel="stylesheet" href="/vendor/fonts/latin-ext-400.css">
    <link rel="stylesheet" href="/vendor/fonts/latin-ext-500.css">
    <link rel="stylesheet" href="/vendor/fonts/latin-ext-600.css">
    <link rel="stylesheet" href="/vendor/fonts/latin-ext-700.css">
    <link rel="stylesheet" href="/vendor/fonts/latin-ext-800.css">
    <link rel="stylesheet" href="/css/theme.css">
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/app.js" defer></script>
  </head>
  <body class="app-body">
    <div class="app-shell">
      {{> sidebar}}
      <div class="app-main">
        <header class="app-topbar">
          <button class="btn btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Abrir menu">
            <i class="bi bi-list" aria-hidden="true"></i>
          </button>
          <span class="topbar-page-label">{{appName}}</span>
          <div class="topbar-user">
            <div class="topbar-user-copy">
              <span class="topbar-user-name">{{currentUser.name}}</span>
              <span class="role-badge">{{roleLabel currentUser.role}}</span>
            </div>
            <form action="/logout" method="post">
              {{> csrf-field}}
              <button class="btn btn-outline-secondary btn-sm" type="submit">
                <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>
                <span class="d-none d-sm-inline">Sair</span>
              </button>
            </form>
          </div>
        </header>
        <main class="app-content">
          {{> flash}}
          {{{body}}}
        </main>
        <footer class="app-footer">
          <span>&copy; {{appName}}</span>
          <span>Angola · Kz</span>
        </footer>
      </div>
    </div>
  </body>
</html>
