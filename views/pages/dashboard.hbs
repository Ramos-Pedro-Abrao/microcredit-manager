<section>
  <h1 class="h2">Welcome, {{currentUser.name}}</h1>
  <p class="text-body-secondary">Signed in as {{currentUser.role}}.</p>
  <div class="d-flex flex-wrap gap-2 mt-4">
    <a class="btn btn-primary" href="/clients">Clients</a>
    {{#if (eq currentUser.role "ADMIN")}}
      <a class="btn btn-outline-primary" href="/users">Manage users</a>
    {{/if}}
  </div>
</section>
