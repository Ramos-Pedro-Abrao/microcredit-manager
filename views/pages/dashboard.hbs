<section>
  <div class="page-heading">
    <div>
      <span class="section-kicker">Visão geral</span>
      <h1>Olá, {{currentUser.name}}</h1>
      <p class="text-body-secondary mb-0">Aqui está um resumo da actividade da plataforma.</p>
    </div>
  </div>
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
      <article class="stat-card">
        <div>
          <span class="stat-label">Verificações pendentes</span>
          <strong class="stat-value">{{pendingVerifications}}</strong>
        </div>
        <span class="stat-icon"><i class="bi bi-person-check" aria-hidden="true"></i></span>
      </article>
    </div>
    {{#if (eq currentUser.role "ADMIN")}}
      <div class="col-sm-6 col-xl-4">
        <article class="stat-card">
          <div>
            <span class="stat-label">Pedidos por analisar</span>
            <strong class="stat-value">{{pendingRequests}}</strong>
          </div>
          <span class="stat-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span>
        </article>
      </div>
    {{else if (eq currentUser.role "MANAGER")}}
      <div class="col-sm-6 col-xl-4">
        <article class="stat-card">
          <div>
            <span class="stat-label">Pedidos por analisar</span>
            <strong class="stat-value">{{pendingRequests}}</strong>
          </div>
          <span class="stat-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span>
        </article>
      </div>
    {{/if}}
  </div>
  <div class="page-heading mt-4">
    <div>
      <h2 class="h4">Acesso rápido</h2>
      <p class="text-body-secondary mb-0">Escolha uma área para continuar.</p>
    </div>
  </div>
  <div class="row g-3">
    <div class="col-md-6 col-xl-4">
      <a class="quick-action-card" href="/clients">
        <span class="benefit-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
        <span><strong>Clientes</strong><small>Consultar e gerir registos</small></span>
        <i class="bi bi-arrow-up-right ms-auto" aria-hidden="true"></i>
      </a>
    </div>
    {{#if (eq currentUser.role "ADMIN")}}
      <div class="col-md-6 col-xl-4">
        <a class="quick-action-card" href="/users">
          <span class="benefit-icon"><i class="bi bi-person-gear" aria-hidden="true"></i></span>
          <span><strong>Utilizadores</strong><small>Gerir acessos da equipa</small></span>
          <i class="bi bi-arrow-up-right ms-auto" aria-hidden="true"></i>
        </a>
      </div>
    {{/if}}
    {{#if (eq currentUser.role "ADMIN")}}
      <div class="col-md-6 col-xl-4">
        <a class="quick-action-card" href="/requests">
          <span class="benefit-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span>
          <span><strong>Pedidos de crédito</strong><small>Rever pedidos submetidos</small></span>
          <i class="bi bi-arrow-up-right ms-auto" aria-hidden="true"></i>
        </a>
      </div>
    {{else if (eq currentUser.role "MANAGER")}}
      <div class="col-md-6 col-xl-4">
        <a class="quick-action-card" href="/requests">
          <span class="benefit-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span>
          <span><strong>Pedidos de crédito</strong><small>Rever pedidos submetidos</small></span>
          <i class="bi bi-arrow-up-right ms-auto" aria-hidden="true"></i>
        </a>
      </div>
    {{/if}}
  </div>
</section>
