<section class="form-page">
  <div class="page-heading"><div><span class="section-kicker">Crédito</span><h1>Novo pedido de crédito</h1></div></div>
  {{#if errors.length}}
    <div class="alert alert-danger" role="alert">
      <ul class="mb-0">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>
    </div>
  {{/if}}
  <form action="/portal/requests" method="post">
    {{> csrf-field}}
    <div class="mb-3">
      <label class="form-label" for="amount">Montante (Kz) <span class="text-danger">*</span></label>
      <input class="form-control" id="amount" name="amount" type="number" min="0.01" step="0.01" value="{{values.amount}}" required>
    </div>
    <div class="mb-3">
      <label class="form-label" for="term_months">Prazo (meses) <span class="text-danger">*</span></label>
      <input class="form-control" id="term_months" name="term_months" type="number" min="1" max="60" step="1" value="{{values.term_months}}" required>
    </div>
    <div class="mb-3">
      <label class="form-label" for="frequency">Frequência de pagamento <span class="text-danger">*</span></label>
      <select class="form-select" id="frequency" name="frequency" required>
        <option value="">Seleccione a frequência</option>
        <option value="WEEKLY" {{selected values.frequency "WEEKLY"}}>Semanal</option>
        <option value="BIWEEKLY" {{selected values.frequency "BIWEEKLY"}}>Quinzenal</option>
        <option value="MONTHLY" {{selected values.frequency "MONTHLY"}}>Mensal</option>
      </select>
    </div>
    <div class="mb-3">
      <label class="form-label" for="purpose">Finalidade <span class="text-danger">*</span></label>
      <textarea class="form-control" id="purpose" name="purpose" rows="4" required>{{values.purpose}}</textarea>
    </div>
    <button class="btn btn-primary" type="submit">Submeter pedido</button>
    <a class="btn btn-outline-secondary" href="/portal">Cancelar</a>
  </form>
</section>
