<section class="form-page">
  <div class="page-heading"><div><span class="section-kicker">A sua conta</span><h1>O meu perfil</h1></div></div>
  <p class="text-body-secondary">O nome e o documento de identificação não podem ser alterados aqui.</p>
  {{#if errors.length}}
    <div class="alert alert-danger" role="alert">
      <ul class="mb-0">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>
    </div>
  {{/if}}
  <dl class="row detail-list">
    <dt class="col-sm-3">Nome completo</dt><dd class="col-sm-9">{{client.full_name}}</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">{{client.email}}</dd>
    <dt class="col-sm-3">Documento</dt><dd class="col-sm-9">{{client.document_type}}: {{client.document_number}}</dd>
  </dl>
  <form action="/portal/profile" method="post">
    {{> csrf-field}}
    <div class="mb-3">
      <label class="form-label" for="phone">Telefone</label>
      <input class="form-control" id="phone" name="phone" maxlength="40" value="{{client.phone}}">
    </div>
    <div class="mb-3">
      <label class="form-label" for="address">Morada</label>
      <input class="form-control" id="address" name="address" maxlength="255" value="{{client.address}}">
    </div>
    <div class="mb-3">
      <label class="form-label" for="occupation">Profissão</label>
      <input class="form-control" id="occupation" name="occupation" maxlength="120" value="{{client.occupation}}">
    </div>
    <div class="mb-3">
      <label class="form-label" for="monthly_income">Rendimento mensal (Kz)</label>
      <input class="form-control" id="monthly_income" name="monthly_income" type="number" min="0" step="0.01" value="{{client.monthly_income}}">
    </div>
    <button class="btn btn-primary" type="submit">Guardar perfil</button>
    <a class="btn btn-outline-secondary" href="/portal">Voltar ao portal</a>
  </form>
</section>
