<section class="py-4">
  <div class="page-heading"><div><span class="section-kicker">Crédito</span><h1>{{#if message}}Pedido não disponível{{else}}Verificação necessária{{/if}}</h1></div></div>
  {{#if message}}
    <p>{{message}}</p>
  {{else}}
    <p>O seu registo está <strong>{{statusLabel client.verification_status}}</strong>. Poderá pedir crédito depois da verificação dos seus dados pela equipa.</p>
  {{/if}}
  <a class="btn btn-primary" href="/portal">Voltar ao portal</a>
</section>
