<section>
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
      <span class="section-kicker">A sua conta</span>
      <h1>Portal do cliente</h1>
      <p class="text-body-secondary">Bem-vindo(a), {{client.full_name}}.</p>
    </div>
    <a class="btn btn-outline-primary" href="/portal/profile">Editar perfil</a>
  </div>

  <div class="status-card my-4 {{statusClass client.verification_status}}">
    <span class="status-icon" aria-hidden="true">
      {{#if (eq client.verification_status "VERIFIED")}}<i class="bi bi-patch-check-fill"></i>{{else if (eq client.verification_status "REJECTED")}}<i class="bi bi-x-circle-fill"></i>{{else}}<i class="bi bi-hourglass-split"></i>{{/if}}
    </span>
    <div>
      <h2>Estado da verificação</h2>
      <p><strong>{{statusLabel client.verification_status}}</strong></p>
      {{#if (eq client.verification_status "PENDING")}}
        <p class="mt-2">Os seus dados estão a ser analisados. Poderá submeter um pedido de crédito depois da verificação.</p>
      {{/if}}
      {{#if (eq client.verification_status "REJECTED")}}
        <p class="mt-2"><strong>Motivo:</strong> {{client.rejection_reason}}</p>
      {{/if}}
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h4 mb-0">Os meus pedidos de crédito</h2>
    {{#if (eq client.verification_status "VERIFIED")}}
      <a class="btn btn-primary" href="/portal/requests/new">Novo pedido</a>
    {{/if}}
  </div>
  {{#if requests.length}}
    <div class="table-responsive">
      <div class="table-shell"><div class="table-responsive"><table class="table align-middle">
        <thead>
          <tr><th>Pedido</th><th>Montante</th><th>Prazo</th><th>Frequência</th><th>Estado</th><th>Submetido</th><th></th></tr>
        </thead>
        <tbody>
          {{#each requests}}
            <tr>
              <td>#{{this.id}}</td>
              <td>{{formatKz this.amount}}</td>
              <td>{{this.term_months}} meses</td>
              <td>{{this.frequency}}</td>
              <td>{{> status-badge value=this.status}}</td>
              <td>{{formatDate this.created_at}}</td>
              <td>
                {{#if (eq this.status "PENDING")}}
                  <form action="/portal/requests/{{this.id}}/cancel" method="post">
                    {{> csrf-field}}
                    <button class="btn btn-sm btn-outline-danger" type="submit" data-confirm="Tem a certeza de que pretende cancelar este pedido?">Cancelar</button>
                  </form>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table></div></div>
    </div>
  {{else}}
    {{> empty-state icon="bi-file-earmark-text" message="Ainda não submeteu nenhum pedido de crédito."}}
  {{/if}}
</section>
