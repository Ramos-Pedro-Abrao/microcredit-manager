<section class="form-page">
  <div class="page-heading"><div><span class="section-kicker">Acessos</span><h1>Redefinir palavra-passe</h1></div></div>
  <p class="text-body-secondary">Defina uma nova palavra-passe para {{user.name}} ({{user.email}}).</p>
  {{#if errors.length}}
    <div class="alert alert-danger" role="alert">
      <ul class="mb-0">
        {{#each errors}}<li>{{this}}</li>{{/each}}
      </ul>
    </div>
  {{/if}}
  <form action="/users/{{user.id}}/password" method="post">
    {{> csrf-field}}
    <div class="mb-3">
      <label class="form-label" for="password">Nova palavra-passe</label>
      <input class="form-control" id="password" name="password" type="password" minlength="10" autocomplete="new-password" required>
      <div class="form-text">Utilize pelo menos 10 caracteres.</div>
    </div>
    <button class="btn btn-primary" type="submit">Redefinir palavra-passe</button>
    <a class="btn btn-outline-secondary" href="/users">Cancelar</a>
  </form>
</section>
