<section class="form-page">
  <h1 class="h2 mb-2">Reset password</h1>
  <p class="text-body-secondary">Set a new password for {{user.name}} ({{user.email}}).</p>
  {{#if errors.length}}
    <div class="alert alert-danger" role="alert">
      <ul class="mb-0">
        {{#each errors}}<li>{{this}}</li>{{/each}}
      </ul>
    </div>
  {{/if}}
  <form action="/users/{{user.id}}/password" method="post">
    {{> csrf-field}}
    <div class="mb-3">
      <label class="form-label" for="password">New password</label>
      <input class="form-control" id="password" name="password" type="password" minlength="10" autocomplete="new-password" required>
      <div class="form-text">Use at least 10 characters.</div>
    </div>
    <button class="btn btn-primary" type="submit">Reset password</button>
    <a class="btn btn-outline-secondary" href="/users">Cancel</a>
  </form>
</section>
