<section>
  <div class="page-heading">
    <div><span class="section-kicker">Acessos</span><h1>Utilizadores</h1></div>
    <a class="btn btn-primary" href="/users/new"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Novo utilizador</a>
  </div>
  {{#if users.length}}
    <div class="table-responsive">
      <div class="table-shell"><table class="table align-middle">
        <thead>
          <tr>
            <th scope="col">Nome</th>
            <th scope="col">Email</th>
            <th scope="col">Perfil</th>
            <th scope="col">Estado</th>
            <th scope="col">Criado</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          {{#each users}}
            <tr>
              <td>{{this.name}}</td>
              <td>{{this.email}}</td>
              <td>{{roleLabel this.role}}</td>
              <td>{{#if this.is_active}}<span class="status-badge status-success">Activo</span>{{else}}<span class="status-badge status-muted">Inactivo</span>{{/if}}</td>
              <td>{{formatDate this.created_at}}</td>
              <td>
                <div class="d-flex flex-wrap gap-2">
                  <a class="btn btn-sm btn-outline-primary" href="/users/{{this.id}}/edit">Editar</a>
                  <a class="btn btn-sm btn-outline-secondary" href="/users/{{this.id}}/password">Redefinir palavra-passe</a>
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table></div>
    </div>
  {{else}}
    {{> empty-state icon="bi-person-gear" message="Ainda não existem utilizadores registados."}}
  {{/if}}
</section>
