              <circle cx="196" cy="328" r="5" fill="#fff" fill-opacity=".83"/><circle cx="216" cy="328" r="5" fill="#fff" fill-opacity=".83"/><circle cx="236" cy="328" r="5" fill="#fff" fill-opacity=".83"/><circle cx="256" cy="328" r="5" fill="#fff" fill-opacity=".83"/>
