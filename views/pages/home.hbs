<section class="hero-section" id="inicio">
  <div class="container">
    <div class="row hero-grid g-4 g-lg-5">
      <div class="col-lg-7 hero-copy">
        <span class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> Uma forma simples de avançar</span>
        <h1 class="hero-title">Crédito rápido e seguro <em>para si.</em></h1>
        <p class="hero-description">
          Faça o seu pedido online, acompanhe cada etapa e receba uma resposta clara da nossa equipa.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/register">Pedir crédito <i class="bi bi-arrow-up-right ms-1" aria-hidden="true"></i></a>
          <a class="btn btn-outline-primary" href="/login">Já tenho conta</a>
        </div>
        <div class="hero-trust" aria-label="Vantagens do serviço">
