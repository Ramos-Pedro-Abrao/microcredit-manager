<section>
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="mb-0">Pedido de crédito #{{request.id}}</h1>
    <a class="btn btn-outline-secondary" href="/requests">Voltar aos pedidos</a>
  </div>
  {{#if errors.length}}
    <div class="alert alert-danger" role="alert">
      <ul class="mb-0">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>
    </div>
  {{/if}}
  <dl class="row detail-list">
    <dt class="col-sm-3">Cliente</dt><dd class="col-sm-9"><a href="/clients/{{request.client_id}}">{{request.full_name}}</a></dd>
    <dt class="col-sm-3">Documento</dt><dd class="col-sm-9">{{request.document_number}}</dd>
    <dt class="col-sm-3">Verificação do cliente</dt><dd class="col-sm-9">{{> status-badge value=request.verification_status}}</dd>
    <dt class="col-sm-3">Montante solicitado</dt><dd class="col-sm-9">{{formatKz request.amount}}</dd>
    <dt class="col-sm-3">Prazo</dt><dd class="col-sm-9">{{request.term_months}} meses</dd>
    <dt class="col-sm-3">Frequência</dt><dd class="col-sm-9">{{request.frequency}}</dd>
    <dt class="col-sm-3">Finalidade</dt><dd class="col-sm-9">{{request.purpose}}</dd>
    <dt class="col-sm-3">Estado</dt><dd class="col-sm-9">{{> status-badge value=request.status}}</dd>
    {{#if request.approved_amount}}
      <dt class="col-sm-3">Montante aprovado</dt><dd class="col-sm-9">{{formatKz request.approved_amount}}</dd>
      <dt class="col-sm-3">Taxa aprovada</dt><dd class="col-sm-9">{{request.approved_interest_rate}}%</dd>
    {{/if}}
    {{#if request.review_notes}}
      <dt class="col-sm-3">Notas da análise</dt><dd class="col-sm-9">{{request.review_notes}}</dd>
    {{/if}}
    <dt class="col-sm-3">Submetido</dt><dd class="col-sm-9">{{formatDate request.created_at}}</dd>
  </dl>

  {{#if (eq request.status "PENDING")}}
    {{#if (eq request.verification_status "VERIFIED")}}
      <section class="row g-4 mt-2">
        <div class="col-lg-6">
          <div class="card h-100">
            <div class="card-body">
              <h2 class="h5">Aprovar pedido</h2>
              <form action="/requests/{{request.id}}/review" method="post">
                {{> csrf-field}}
                <input type="hidden" name="decision" value="APPROVED">
                <div class="mb-3">
                  <label class="form-label" for="approved_amount">Montante aprovado (Kz)</label>
                  <input class="form-control" id="approved_amount" name="approved_amount" type="number" min="0.01" step="0.01" value="{{#if values.approved_amount}}{{values.approved_amount}}{{else}}{{request.amount}}{{/if}}" required>
                </div>
                <div class="mb-3">
                  <label class="form-label" for="approved_interest_rate">Taxa de juro (%)</label>
                  <input class="form-control" id="approved_interest_rate" name="approved_interest_rate" type="number" min="0" step="0.0001" value="{{values.approved_interest_rate}}" required>
                </div>
                <div class="mb-3">
                  <label class="form-label" for="approval_notes">Notas da análise</label>
                  <textarea class="form-control" id="approval_notes" name="review_notes" rows="3">{{values.review_notes}}</textarea>
                </div>
                <button class="btn btn-success" type="submit">Aprovar pedido</button>
              </form>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="card h-100">
            <div class="card-body">
              <h2 class="h5">Rejeitar pedido</h2>
              <form action="/requests/{{request.id}}/review" method="post">
                {{> csrf-field}}
                <input type="hidden" name="decision" value="REJECTED">
                <div class="mb-3">
                  <label class="form-label" for="rejection_notes">Motivo <span class="text-danger">*</span></label>
                  <textarea class="form-control" id="rejection_notes" name="review_notes" rows="3" required>{{values.review_notes}}</textarea>
                </div>
                <button class="btn btn-outline-danger" type="submit">Rejeitar pedido</button>
              </form>
            </div>
          </div>
        </div>
      </section>
    {{else}}
      <div class="alert alert-warning">O cliente deve ser verificado antes da análise deste pedido.</div>
    {{/if}}
  {{/if}}
</section>
