<section class="auth-page">
  <div class="container">
    <div class="auth-shell">
      <div class="row g-0">
        <div class="col-md-5">
          <aside class="auth-panel">
            {{> brand}}
            <div>
              <h2>Bem-vindo de volta.</h2>
              <p>Entre na sua conta para acompanhar os seus pedidos e continuar o seu percurso.</p>
            </div>
            <div class="auth-panel-art" aria-hidden="true">
              <svg viewBox="0 0 280 190" xmlns="http://www.w3.org/2000/svg">
                <rect x="34" y="34" width="207" height="126" rx="18" fill="#12B76A" transform="rotate(-7 34 34)"/>
                <rect x="51" y="76" width="207" height="94" rx="18" fill="#FFC83D"/>
                <circle cx="199" cy="111" r="20" fill="#fff" fill-opacity=".72"/>
                <circle cx="221" cy="111" r="20" fill="#fff" fill-opacity=".52"/>
                <path d="M75 132h55" stroke="#0B1F3A" stroke-linecap="round" stroke-width="8" opacity=".8"/>
              </svg>
            </div>
          </aside>
        </div>
        <div class="col-md-7">
          <div class="auth-form-panel">
            <div class="auth-form-inner">
              <span class="section-kicker">A sua conta</span>
              <h1>Entrar</h1>
              <p>Introduza os seus dados para aceder à plataforma.</p>
              {{#if error}}
                <div class="alert app-alert alert-danger" role="alert">
                  <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i><span>{{error}}</span>
                </div>
              {{/if}}
              <form action="/login" method="post">
                {{> csrf-field}}
                <input type="hidden" name="returnTo" value="{{returnTo}}">
                <div class="mb-3">
                  <label class="form-label" for="email">Endereço de email</label>
                  <input class="form-control" id="email" name="email" type="email" value="{{values.email}}" autocomplete="username" placeholder="nome@exemplo.ao" required>
                </div>
                <div class="mb-4">
                  <label class="form-label" for="password">Palavra-passe</label>
                  <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" placeholder="Introduza a sua palavra-passe" required>
                </div>
                <button class="btn btn-primary w-100" type="submit">Entrar na minha conta</button>
              </form>
              <p class="auth-split-note mt-4 mb-0 text-center">Ainda não tem conta? <a href="/register">Criar conta de cliente</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
