<section class="auth-page">
  <div class="container">
    <div class="auth-shell">
      <div class="row g-0">
        <div class="col-md-5">
          <aside class="auth-panel">
            {{> brand}}
            <div>
              <h2>Um primeiro passo, com clareza.</h2>
              <p>Crie a sua conta. A equipa irá verificar os seus dados antes de poder submeter um pedido de crédito.</p>
            </div>
            <div class="auth-panel-art" aria-hidden="true">
              <svg viewBox="0 0 280 190" xmlns="http://www.w3.org/2000/svg">
                <circle cx="132" cy="88" r="67" fill="#14315C" stroke="#12B76A" stroke-width="13"/>
                <path d="M101 90l21 21 43-48" fill="none" stroke="#FFC83D" stroke-linecap="round" stroke-linejoin="round" stroke-width="13"/>
                <circle cx="222" cy="143" r="22" fill="#FFC83D"/>
                <path d="M215 143h14" stroke="#755000" stroke-linecap="round" stroke-width="4"/>
              </svg>
            </div>
          </aside>
        </div>
        <div class="col-md-7">
          <div class="auth-form-panel">
            <div class="auth-form-inner">
              <span class="section-kicker">Registo de cliente</span>
              <h1>Criar conta</h1>
              <p>Preencha os seus dados. Os campos assinalados são obrigatórios.</p>
              {{#if errors.length}}
                <div class="alert app-alert alert-danger" role="alert">
                  <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
                  <ul class="mb-0 ps-0 list-unstyled">
                    {{#each errors}}<li>{{this}}</li>{{/each}}
                  </ul>
                </div>
              {{/if}}
              <form action="/register" method="post">
                {{> csrf-field}}
                <div class="row g-3">
                  <div class="col-12">
                    <label class="form-label" for="full_name">Nome completo <span class="text-danger">*</span></label>
                    <input class="form-control" id="full_name" name="full_name" maxlength="180" value="{{values.full_name}}" autocomplete="name" required>
                  </div>
                  <div class="col-12">
                    <label class="form-label" for="email">Endereço de email <span class="text-danger">*</span></label>
                    <input class="form-control" id="email" name="email" type="email" maxlength="254" value="{{values.email}}" autocomplete="email" required>
                  </div>
                  <div class="col-sm-6">
                    <label class="form-label" for="phone">Telefone</label>
                    <input class="form-control" id="phone" name="phone" maxlength="40" value="{{values.phone}}" autocomplete="tel">
                  </div>
                  <div class="col-sm-6">
                    <label class="form-label" for="document_type">Tipo de documento <span class="text-danger">*</span></label>
                    <input class="form-control" id="document_type" name="document_type" maxlength="40" value="{{values.document_type}}" required>
                  </div>
                  <div class="col-sm-6">
                    <label class="form-label" for="document_number">Número do documento <span class="text-danger">*</span></label>
                    <input class="form-control" id="document_number" name="document_number" maxlength="100" value="{{values.document_number}}" required>
                  </div>
                  <div class="col-sm-6">
                    <label class="form-label" for="occupation">Profissão</label>
                    <input class="form-control" id="occupation" name="occupation" maxlength="120" value="{{values.occupation}}">
                  </div>
                  <div class="col-12">
                    <label class="form-label" for="address">Morada</label>
                    <input class="form-control" id="address" name="address" maxlength="255" value="{{values.address}}" autocomplete="street-address">
                  </div>
                  <div class="col-12">
                    <label class="form-label" for="monthly_income">Rendimento mensal (Kz)</label>
                    <input class="form-control" id="monthly_income" name="monthly_income" type="number" min="0" step="0.01" value="{{values.monthly_income}}">
                  </div>
                  <div class="col-sm-6">
                    <label class="form-label" for="password">Palavra-passe <span class="text-danger">*</span></label>
                    <input class="form-control" id="password" name="password" type="password" minlength="10" autocomplete="new-password" required>
                    <div class="form-text">Pelo menos 10 caracteres.</div>
                  </div>
                  <div class="col-sm-6">
                    <label class="form-label" for="password_confirmation">Confirmar palavra-passe <span class="text-danger">*</span></label>
                    <input class="form-control" id="password_confirmation" name="password_confirmation" type="password" minlength="10" autocomplete="new-password" required>
                  </div>
                </div>
                <div class="d-grid mt-4">
                  <button class="btn btn-primary" type="submit">Criar a minha conta</button>
                </div>
              </form>
              <p class="auth-split-note mt-4 mb-0 text-center">Já tem uma conta? <a href="/login">Entrar</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
