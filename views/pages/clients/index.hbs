<section>
  <div class="page-heading">
    <div><span class="section-kicker">Gestão</span><h1>Clientes</h1></div>
    <a class="btn btn-primary" href="/clients/new"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Novo cliente</a>
  </div>

  <form class="row g-3 align-items-end filter-card" action="/clients" method="get">
    <div class="col-md-6">
      <label class="form-label" for="search">Pesquisar clientes</label>
      <input class="form-control" id="search" name="search" value="{{search}}" placeholder="Nome, documento ou telefone">
    </div>
    <div class="col-md-3">
      <label class="form-label" for="verification_status">Verificação</label>
      <select class="form-select" id="verification_status" name="verification_status">
        <option value="">Todos os estados</option>
        <option value="PENDING" {{selected verificationStatus "PENDING"}}>Pendente</option>
        <option value="VERIFIED" {{selected verificationStatus "VERIFIED"}}>Verificado</option>
        <option value="REJECTED" {{selected verificationStatus "REJECTED"}}>Rejeitado</option>
      </select>
    </div>
    <div class="col-md-3">
      <label class="form-label" for="status">Estado da conta</label>
      <select class="form-select" id="status" name="status">
        <option value="">Todos os estados</option>
        <option value="ACTIVE" {{selected status "ACTIVE"}}>Activo</option>
        <option value="INACTIVE" {{selected status "INACTIVE"}}>Inactivo</option>
        <option value="BLACKLISTED" {{selected status "BLACKLISTED"}}>Lista negra</option>
      </select>
    </div>
    <div class="col-12 d-flex gap-2">
      <button class="btn btn-primary" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>Pesquisar</button>
      <a class="btn btn-outline-secondary" href="/clients">Limpar</a>
    </div>
  </form>

  <p class="text-body-secondary small">{{total}} cliente(s) encontrado(s).</p>
  {{#if clients.length}}
    <div class="table-shell">
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th scope="col">Nome</th>
            <th scope="col">Documento</th>
            <th scope="col">Telefone</th>
            <th scope="col">Estado</th>
            <th scope="col">Verificação</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          {{#each clients}}
            <tr>
              <td>{{this.full_name}}</td>
              <td>{{this.document_type}}: {{this.document_number}}</td>
              <td>{{this.phone}}</td>
              <td>{{> status-badge value=this.status}}</td>
              <td>{{> status-badge value=this.verification_status}}</td>
              <td><a class="btn btn-sm btn-outline-primary" href="/clients/{{this.id}}" aria-label="Ver cliente {{this.full_name}}">Ver</a></td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    </div>
  {{else}}
    {{> empty-state icon="bi-people" message="Ainda não existem clientes com estes critérios."}}
  {{/if}}
  {{> pagination}}
</section>
