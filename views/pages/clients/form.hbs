<section class="form-page">
  <h1 class="h2 mb-4">{{heading}}</h1>
  {{#if errors.length}}
    <div class="alert alert-danger" role="alert">
      <ul class="mb-0">
        {{#each errors}}<li>{{this}}</li>{{/each}}
      </ul>
    </div>
  {{/if}}
  <form action="{{action}}" method="post">
    {{> csrf-field}}
    <div class="mb-3">
      <label class="form-label" for="full_name">Full name <span class="text-danger">*</span></label>
      <input class="form-control" id="full_name" name="full_name" maxlength="180" value="{{values.full_name}}" required>
    </div>
    <div class="row g-3">
      <div class="col-md-6 mb-3">
        <label class="form-label" for="document_type">Document type <span class="text-danger">*</span></label>
        <input class="form-control" id="document_type" name="document_type" maxlength="40" value="{{values.document_type}}" required>
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label" for="document_number">Document number <span class="text-danger">*</span></label>
        <input class="form-control" id="document_number" name="document_number" maxlength="100" value="{{values.document_number}}" required>
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label" for="phone">Phone</label>
        <input class="form-control" id="phone" name="phone" maxlength="40" value="{{values.phone}}">
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label" for="occupation">Occupation</label>
        <input class="form-control" id="occupation" name="occupation" maxlength="120" value="{{values.occupation}}">
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label" for="monthly_income">Monthly income (Kz)</label>
        <input class="form-control" id="monthly_income" name="monthly_income" type="number" min="0" step="0.01" value="{{values.monthly_income}}">
      </div>
      {{#if canChangeStatus}}
        {{#if editing}}
          <div class="col-md-6 mb-3">
            <label class="form-label" for="status">Status</label>
            <select class="form-select" id="status" name="status">
              <option value="ACTIVE" {{selected values.status "ACTIVE"}}>Active</option>
              <option value="INACTIVE" {{selected values.status "INACTIVE"}}>Inactive</option>
              <option value="BLACKLISTED" {{selected values.status "BLACKLISTED"}}>Blacklisted</option>
            </select>
          </div>
        {{/if}}
      {{/if}}
    </div>
    <div class="mb-3">
      <label class="form-label" for="address">Address</label>
      <input class="form-control" id="address" name="address" maxlength="255" value="{{values.address}}">
    </div>
    <button class="btn btn-primary" type="submit">{{#if editing}}Save changes{{else}}Create client{{/if}}</button>
    <a class="btn btn-outline-secondary" href="/clients">Cancel</a>
  </form>
</section>
