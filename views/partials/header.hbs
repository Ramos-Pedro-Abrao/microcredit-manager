<header class="border-bottom">
  <nav class="navbar navbar-expand-lg container" aria-label="Main navigation">
    <a class="navbar-brand fw-semibold" href="/">Microcredit Manager</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="main-navigation">
      <div class="navbar-nav ms-auto">
        {{#if currentUser}}
          {{#if (eq currentUser.role "CLIENT")}}
            <a class="nav-link" href="/portal">Portal</a>
            <a class="nav-link" href="/portal/profile">Profile</a>
          {{else}}
            <a class="nav-link" href="/dashboard">Dashboard</a>
            <a class="nav-link" href="/clients">Clients</a>
            {{#if (eq currentUser.role "ADMIN")}}
              <a class="nav-link" href="/requests">Requests</a>
            {{else if (eq currentUser.role "MANAGER")}}
              <a class="nav-link" href="/requests">Requests</a>
            {{/if}}
            {{#if (eq currentUser.role "ADMIN")}}
              <a class="nav-link" href="/users">Users</a>
            {{/if}}
          {{/if}}
          <span class="navbar-text px-lg-3">{{currentUser.name}}</span>
          <form action="/logout" method="post" class="d-flex align-items-center">
            {{> csrf-field}}
            <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
          </form>
        {{else}}
          <a class="nav-link" href="/login">Login</a>
          <a class="nav-link" href="/register">Register</a>
        {{/if}}
      </div>
    </div>
  </nav>
</header>
