<aside class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1" id="appSidebar" aria-labelledby="appSidebarLabel">
  <div class="offcanvas-header sidebar-mobile-header">
    <h2 class="offcanvas-title" id="appSidebarLabel">{{> brand}}</h2>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Fechar menu"></button>
  </div>
  <div class="offcanvas-body sidebar-body">
    <div class="sidebar-brand d-none d-lg-flex">{{> brand}}</div>
    <p class="sidebar-caption">MENU PRINCIPAL</p>
    <nav class="sidebar-nav" aria-label="Menu da conta">
      {{#if (eq currentUser.role "CLIENT")}}
        <a class="sidebar-link" href="/portal"><i class="bi bi-grid-1x2" aria-hidden="true"></i><span>Portal</span></a>
        <a class="sidebar-link" href="/portal/profile"><i class="bi bi-person-circle" aria-hidden="true"></i><span>Perfil</span></a>
      {{else}}
        <a class="sidebar-link" href="/dashboard"><i class="bi bi-grid-1x2" aria-hidden="true"></i><span>Painel</span></a>
        <a class="sidebar-link" href="/clients"><i class="bi bi-people" aria-hidden="true"></i><span>Clientes</span></a>
        {{#if (eq currentUser.role "ADMIN")}}
          <a class="sidebar-link" href="/requests"><i class="bi bi-file-earmark-text" aria-hidden="true"></i><span>Pedidos de crédito</span></a>
          <a class="sidebar-link" href="/users"><i class="bi bi-person-gear" aria-hidden="true"></i><span>Utilizadores</span></a>
        {{else if (eq currentUser.role "MANAGER")}}
          <a class="sidebar-link" href="/requests"><i class="bi bi-file-earmark-text" aria-hidden="true"></i><span>Pedidos de crédito</span></a>
        {{/if}}
      {{/if}}
    </nav>
    <div class="sidebar-help">
      <span class="sidebar-help-icon"><i class="bi bi-headset" aria-hidden="true"></i></span>
      <strong>Precisa de ajuda?</strong>
      <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>
    </div>
    <div class="sidebar-account">
      <span class="account-avatar" aria-hidden="true"><i class="bi bi-person-fill"></i></span>
      <span class="account-name">{{currentUser.name}}</span>
    </div>
  </div>
</aside>
